{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shromikai.app/schemas/audit/audit-detail.v1.schema.json",
  "title": "AuditDetail",
  "description": "Closed set of content-free keys an audit_event.detail may carry (FR-10, R-02).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "reason": { "type": "string", "pattern": "^[a-z_]{1,40}$" },
    "role": { "enum": ["WORKER", "HR", "ADMIN"] },
    "demo": { "type": "boolean" },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "httpMethod": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] },
    "httpPath": { "type": "string", "maxLength": 200, "pattern": "^/[A-Za-z0-9._~/-]*$" }
  }
}
