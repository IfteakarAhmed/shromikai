{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shromikai:schema:llm:clause-facts:1",
  "title": "clause-facts output",
  "type": "object",
  "properties": {
    "status": { "type": "string", "enum": ["OK", "ABSTAIN"] },
    "reason": { "type": "string", "enum": ["NONE", "UNREADABLE"] },
    "clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "parameter": {
                  "type": "string",
                  "enum": [
                    "PROBATION_LENGTH", "PROBATION_EXTENSION", "CONTRACT_DURATION",
                    "NOTICE_BY_EMPLOYER", "NOTICE_BY_WORKER", "PAY_IN_LIEU_OF_NOTICE_ALLOWED",
                    "DAILY_WORKING_HOURS", "WEEKLY_WORKING_HOURS", "OVERTIME_RATE",
                    "OVERTIME_DAILY_HOURS", "OVERTIME_COMPULSORY", "WEEKLY_REST_DAYS",
                    "ANNUAL_LEAVE", "CASUAL_LEAVE", "SICK_LEAVE", "FESTIVAL_HOLIDAYS",
                    "MATERNITY_LEAVE", "WAGE_PERIOD", "WAGE_PAYMENT_DEADLINE", "DEDUCTION_LIMIT",
                    "BASIC_WAGE", "GROSS_WAGE", "TERMINATION_WITHOUT_NOTICE_ALLOWED",
                    "TERMINATION_BENEFIT_STATED", "NON_COMPETE_DURATION", "DISPUTE_FORUM_STATED"
                  ]
                },
                "value": { "type": "number" },
                "unit": {
                  "type": "string",
                  "enum": [
                    "DAYS", "WEEKS", "MONTHS", "HOURS_PER_DAY", "HOURS_PER_WEEK", "MULTIPLIER",
                    "PERCENT", "BDT_PER_MONTH", "COUNT", "BOOLEAN"
                  ]
                },
                "confidence": { "type": "number" }
              },
              "required": ["parameter", "value", "unit", "confidence"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "facts"],
        "additionalProperties": false
      }
    }
  },
  "required": ["status", "reason", "clauses"],
  "additionalProperties": false
}
