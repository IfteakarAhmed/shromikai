{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shromikai:schema:llm:counter-offer:1",
  "title": "counter-offer output",
  "type": "object",
  "properties": {
    "status": { "type": "string", "enum": ["OK", "ABSTAIN"] },
    "reason": { "type": "string", "enum": ["NONE", "CANNOT_RESOLVE"] },
    "action": { "type": "string", "enum": ["REPLACE", "INSERT"] },
    "proposed_text": { "type": "string" },
    "rationale": { "type": "string" }
  },
  "required": ["status", "reason", "action", "proposed_text", "rationale"],
  "additionalProperties": false
}
