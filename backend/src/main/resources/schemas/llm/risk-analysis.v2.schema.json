{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shromikai:schema:llm:risk-analysis:2",
  "title": "risk-analysis output (v2: bounded)",
  "type": "object",
  "properties": {
    "status": { "type": "string", "enum": ["OK", "ABSTAIN"] },
    "reason": { "type": "string", "enum": ["NONE", "NOT_AN_EMPLOYMENT_CONTRACT", "UNREADABLE"] },
    "findings": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "maxLength": 50 },
          "kind": { "type": "string", "enum": ["CONFLICT", "OMISSION", "AMBIGUITY", "INTERACTION"] },
          "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
          "non_obvious": { "type": "boolean" },
          "clause_type": {
            "type": "string",
            "enum": [
              "APPOINTMENT_AND_ROLE", "PROBATION", "WAGES", "WAGE_PAYMENT_AND_DEDUCTIONS",
              "WORKING_HOURS", "OVERTIME", "REST_AND_HOLIDAYS", "LEAVE", "MATERNITY_BENEFIT",
              "NOTICE_AND_RESIGNATION", "TERMINATION", "DISCIPLINE_AND_MISCONDUCT",
              "SERVICE_BENEFITS", "TRANSFER_AND_DEPLOYMENT", "CONFIDENTIALITY", "NON_COMPETE",
              "INTELLECTUAL_PROPERTY", "HEALTH_AND_SAFETY", "DISPUTE_RESOLUTION", "GOVERNING_LAW",
              "GENERAL_PROVISIONS", "OTHER"
            ]
          },
          "clause_ids": { "type": "array", "maxItems": 5, "items": { "type": "string" } },
          "explanation": { "type": "string", "maxLength": 160 },
          "citations": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "section_key": { "type": "string" },
                "quote": { "type": "string", "maxLength": 120 },
                "claim": { "type": "string", "maxLength": 100 }
              },
              "required": ["section_key", "quote", "claim"],
              "additionalProperties": false
            }
          },
          "confidence": { "type": "number" }
        },
        "required": [
          "title", "kind", "severity", "non_obvious", "clause_type", "clause_ids", "explanation",
          "citations", "confidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["status", "reason", "findings"],
  "additionalProperties": false
}
