{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shromikai:schema:llm:verify-support:2",
  "title": "verify-support output",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "enum": [
        "SUPPORTS",
        "PARTIAL",
        "CONTRADICTS",
        "UNRELATED"
      ]
    },
    "confidence": {
      "type": "number"
    },
    "reason": {
      "type": "string",
      "maxLength": 200
    }
  },
  "required": [
    "label",
    "confidence",
    "reason"
  ],
  "additionalProperties": false
}
