# Copy to .env and fill in. Never commit .env. Secrets come only from the environment
# (architecture §12). Model IDs are not set here; they live in shromikai.models.* (conflict C16).

# --- Cloud models -------------------------------------------------------------------------
# Claude (reasoning, fast and fallback-verifier roles). Needed for real analyses (from P4/P6).
ANTHROPIC_API_KEY=
# Gemini verifier and judge (optional). Empty GEMINI_MODEL: the Claude fallback verifier is used.
GEMINI_API_KEY=
GEMINI_MODEL=
# Gemini list prices in US$ per million tokens; required when GEMINI_MODEL is set (cost ledger).
GEMINI_PRICE_IN=
GEMINI_PRICE_OUT=

# --- Security -----------------------------------------------------------------------------
# HS256 signing key for access tokens, at least 32 random bytes (P2): openssl rand -base64 48
JWT_SECRET=
# HMAC keys for signed result envelopes, "kid:base64key[,kid:base64key]" (P7).
SHROMIKAI_ENVELOPE_KEYS=
# Password of the seeded judge accounts in the demo profile (P2).
DEMO_PASSWORD=

# --- Infrastructure -----------------------------------------------------------------------
# Host port of the compose database; change it (and DB_URL) if 5432 is taken on your machine.
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/shromikai
DB_USER=shromikai
DB_PASSWORD=shromikai
OLLAMA_URL=http://localhost:11434
CORS_ORIGINS=http://localhost:5173
# Basic-auth password of the n8n editor (P11).
N8N_BASIC_AUTH_PASSWORD=
# Contact address in the statute scraper's User-Agent (P3).
SCRAPER_CONTACT=
