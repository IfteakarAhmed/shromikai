{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": [
    "vite.config.ts",
    "src/lib/siteUrl.ts",
    "eslint.config.js",
    "playwright.config.ts",
    "scripts/*.mjs",
    "e2e/**/*.ts"
  ]
}
