{
  "components" : {
    "schemas" : {
      "Act" : {
        "properties" : {
          "actCode" : {
            "type" : "string"
          },
          "authoritativeLang" : {
            "type" : "string"
          },
          "jurisdiction" : {
            "type" : "string"
          },
          "ratificationStatus" : {
            "type" : "string"
          },
          "sectionCount" : {
            "format" : "int64",
            "type" : "integer"
          },
          "sections" : {
            "items" : {
              "$ref" : "#/components/schemas/SectionRef"
            },
            "type" : "array"
          },
          "sourceUrl" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string"
          },
          "titleBn" : {
            "type" : "string"
          },
          "titleEn" : {
            "type" : "string"
          },
          "year" : {
            "format" : "int32",
            "type" : "integer"
          }
        },
        "required" : [ "actCode", "authoritativeLang", "jurisdiction", "ratificationStatus", "sectionCount", "sections", "sourceUrl", "status", "titleBn", "titleEn", "year" ],
        "type" : "object"
      },
      "ActSummary" : {
        "properties" : {
          "actCode" : {
            "type" : "string"
          },
          "authoritativeLang" : {
            "type" : "string"
          },
          "jurisdiction" : {
            "type" : "string"
          },
          "ratificationStatus" : {
            "type" : "string"
          },
          "sectionCount" : {
            "format" : "int64",
            "type" : "integer"
          },
          "sourceUrl" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string"
          },
          "titleBn" : {
            "type" : "string"
          },
          "titleEn" : {
            "type" : "string"
          },
          "year" : {
            "format" : "int32",
            "type" : "integer"
          }
        },
        "required" : [ "actCode", "authoritativeLang", "jurisdiction", "ratificationStatus", "sectionCount", "sourceUrl", "status", "titleBn", "titleEn", "year" ],
        "type" : "object"
      },
      "GuestRequest" : {
        "default" : null,
        "properties" : {
          "deviceToken" : {
            "maxLength" : 64,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "deviceToken" ],
        "type" : "object"
      },
      "IngestAccepted" : {
        "default" : null,
        "properties" : {
          "ingestRunId" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "required" : [ "ingestRunId" ],
        "type" : "object"
      },
      "IngestRequest" : {
        "default" : null,
        "properties" : {
          "acts" : {
            "items" : {
              "pattern" : "^[A-Za-z][A-Za-z0-9-]{1,31}$",
              "type" : "string"
            },
            "maxItems" : 20,
            "minItems" : 0,
            "nullable" : true,
            "type" : "array"
          }
        },
        "required" : [ "acts" ],
        "type" : "object"
      },
      "LoginRequest" : {
        "default" : null,
        "properties" : {
          "email" : {
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0,
            "type" : "string"
          },
          "password" : {
            "maxLength" : 128,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "email", "password" ],
        "type" : "object"
      },
      "Me" : {
        "default" : null,
        "properties" : {
          "demo" : {
            "type" : "boolean"
          },
          "email" : {
            "nullable" : true,
            "type" : "string"
          },
          "locale" : {
            "type" : "string"
          },
          "org" : {
            "allOf" : [ {
              "$ref" : "#/components/schemas/MeOrg"
            } ],
            "nullable" : true
          },
          "profile" : {
            "additionalProperties" : {
              "type" : "object"
            },
            "nullable" : true,
            "type" : "object"
          },
          "role" : {
            "type" : "string"
          },
          "userId" : {
            "format" : "uuid",
            "nullable" : true,
            "type" : "string"
          }
        },
        "required" : [ "demo", "email", "locale", "org", "profile", "role", "userId" ],
        "type" : "object"
      },
      "MeOrg" : {
        "default" : null,
        "properties" : {
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "kind" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "plan" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "kind", "name", "plan" ],
        "type" : "object"
      },
      "Meta" : {
        "default" : null,
        "properties" : {
          "audit" : {
            "allOf" : [ {
              "$ref" : "#/components/schemas/MetaAudit"
            } ],
            "nullable" : true
          },
          "corpus" : {
            "$ref" : "#/components/schemas/MetaCorpus"
          },
          "models" : {
            "$ref" : "#/components/schemas/MetaModels"
          },
          "name" : {
            "type" : "string"
          },
          "version" : {
            "type" : "string"
          }
        },
        "required" : [ "audit", "corpus", "models", "name", "version" ],
        "type" : "object"
      },
      "MetaAudit" : {
        "default" : null,
        "properties" : {
          "latestEval" : {
            "allOf" : [ {
              "$ref" : "#/components/schemas/MetaLatestEval"
            } ],
            "nullable" : true
          },
          "openReviewItems" : {
            "format" : "int64",
            "type" : "integer"
          },
          "privacyBlocksLast7Days" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "latestEval", "openReviewItems", "privacyBlocksLast7Days" ],
        "type" : "object"
      },
      "MetaCorpus" : {
        "default" : null,
        "properties" : {
          "acts" : {
            "format" : "int64",
            "type" : "integer"
          },
          "currentSections" : {
            "format" : "int64",
            "type" : "integer"
          },
          "embeddedSections" : {
            "format" : "int64",
            "type" : "integer"
          },
          "lastRefreshAt" : {
            "format" : "date-time",
            "nullable" : true,
            "type" : "string"
          },
          "release" : {
            "nullable" : true,
            "type" : "string"
          },
          "sections" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "acts", "currentSections", "embeddedSections", "lastRefreshAt", "release", "sections" ],
        "type" : "object"
      },
      "MetaLatestEval" : {
        "default" : null,
        "properties" : {
          "cases" : {
            "format" : "int64",
            "type" : "integer"
          },
          "citationPrecision" : {
            "format" : "double",
            "type" : "number"
          },
          "fabricatedCitationsShown" : {
            "format" : "int64",
            "type" : "integer"
          },
          "reportDate" : {
            "type" : "string"
          },
          "riskRecall" : {
            "format" : "double",
            "type" : "number"
          }
        },
        "required" : [ "cases", "citationPrecision", "fabricatedCitationsShown", "reportDate", "riskRecall" ],
        "type" : "object"
      },
      "MetaModels" : {
        "default" : null,
        "properties" : {
          "embedding" : {
            "type" : "string"
          },
          "fast" : {
            "type" : "string"
          },
          "judge" : {
            "nullable" : true,
            "type" : "string"
          },
          "localPii" : {
            "type" : "string"
          },
          "reasoning" : {
            "type" : "string"
          },
          "verifier" : {
            "nullable" : true,
            "type" : "string"
          },
          "verifierFallback" : {
            "type" : "string"
          }
        },
        "required" : [ "embedding", "fast", "judge", "localPii", "reasoning", "verifier", "verifierFallback" ],
        "type" : "object"
      },
      "PasswordChangeRequest" : {
        "default" : null,
        "properties" : {
          "currentPassword" : {
            "maxLength" : 128,
            "minLength" : 0,
            "type" : "string"
          },
          "newPassword" : {
            "maxLength" : 128,
            "minLength" : 12,
            "type" : "string"
          }
        },
        "required" : [ "currentPassword", "newPassword" ],
        "type" : "object"
      },
      "Problem" : {
        "description" : "RFC 9457 problem document (api.md §5.14)",
        "properties" : {
          "code" : {
            "description" : "Stable machine code; equals the last segment of type",
            "type" : "string"
          },
          "detail" : {
            "nullable" : true,
            "type" : "string"
          },
          "errors" : {
            "items" : {
              "$ref" : "#/components/schemas/ProblemError"
            },
            "type" : "array"
          },
          "instance" : {
            "description" : "Request path template plus request ID",
            "type" : "string"
          },
          "pages" : {
            "description" : "unreadable-document only",
            "items" : {
              "format" : "int32",
              "minimum" : 1,
              "type" : "integer"
            },
            "type" : "array"
          },
          "retryAfterSeconds" : {
            "format" : "int32",
            "minimum" : 0,
            "nullable" : true,
            "type" : "integer"
          },
          "status" : {
            "format" : "int32",
            "maximum" : 599,
            "minimum" : 400,
            "type" : "integer"
          },
          "title" : {
            "description" : "Localised by Accept-Language",
            "type" : "string"
          },
          "traceId" : {
            "type" : "string"
          },
          "type" : {
            "pattern" : "^urn:shromikai:problem:[a-z0-9-]+$",
            "type" : "string"
          }
        },
        "required" : [ "code", "instance", "status", "title", "traceId", "type" ],
        "type" : "object"
      },
      "ProblemError" : {
        "properties" : {
          "message" : {
            "type" : "string"
          },
          "pointer" : {
            "type" : "string"
          }
        },
        "required" : [ "message", "pointer" ],
        "type" : "object"
      },
      "Related" : {
        "properties" : {
          "kind" : {
            "type" : "string"
          },
          "reviewed" : {
            "type" : "boolean"
          },
          "sectionKey" : {
            "type" : "string"
          }
        },
        "required" : [ "kind", "reviewed", "sectionKey" ],
        "type" : "object"
      },
      "RetrievalResult" : {
        "properties" : {
          "actCode" : {
            "type" : "string"
          },
          "fusedScore" : {
            "format" : "double",
            "type" : "number"
          },
          "headingBn" : {
            "type" : "string"
          },
          "headingEn" : {
            "type" : "string"
          },
          "origin" : {
            "enum" : [ "SEARCH", "GRAPH", "TOPIC_MAP" ],
            "type" : "string"
          },
          "sectionKey" : {
            "type" : "string"
          },
          "sectionNo" : {
            "type" : "string"
          },
          "snippet" : {
            "type" : "string"
          },
          "sourceUrl" : {
            "type" : "string"
          },
          "textRank" : {
            "format" : "int32",
            "type" : "integer"
          },
          "vectorRank" : {
            "format" : "int32",
            "type" : "integer"
          }
        },
        "required" : [ "actCode", "fusedScore", "headingBn", "headingEn", "origin", "sectionKey", "sectionNo", "snippet", "sourceUrl", "textRank", "vectorRank" ],
        "type" : "object"
      },
      "SearchResults" : {
        "default" : null,
        "properties" : {
          "corpusRelease" : {
            "nullable" : true,
            "type" : "string"
          },
          "query" : {
            "type" : "string"
          },
          "results" : {
            "items" : {
              "$ref" : "#/components/schemas/RetrievalResult"
            },
            "type" : "array"
          }
        },
        "required" : [ "corpusRelease", "query", "results" ],
        "type" : "object"
      },
      "Section" : {
        "properties" : {
          "actCode" : {
            "type" : "string"
          },
          "actTitleBn" : {
            "type" : "string"
          },
          "actTitleEn" : {
            "type" : "string"
          },
          "authoritativeLang" : {
            "type" : "string"
          },
          "authoritativeText" : {
            "type" : "string"
          },
          "contentHash" : {
            "type" : "string"
          },
          "corpusRelease" : {
            "type" : "string"
          },
          "effectiveFrom" : {
            "format" : "date",
            "type" : "string"
          },
          "fetchedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "headingBn" : {
            "type" : "string"
          },
          "headingEn" : {
            "type" : "string"
          },
          "isCurrent" : {
            "type" : "boolean"
          },
          "related" : {
            "items" : {
              "$ref" : "#/components/schemas/Related"
            },
            "type" : "array"
          },
          "sectionKey" : {
            "type" : "string"
          },
          "sectionNo" : {
            "type" : "string"
          },
          "sectionNoOriginal" : {
            "type" : "string"
          },
          "sourceUrl" : {
            "type" : "string"
          },
          "translation" : {
            "$ref" : "#/components/schemas/Translation"
          },
          "versionLabel" : {
            "type" : "string"
          }
        },
        "required" : [ "actCode", "actTitleBn", "actTitleEn", "authoritativeLang", "authoritativeText", "contentHash", "corpusRelease", "effectiveFrom", "fetchedAt", "headingBn", "headingEn", "isCurrent", "related", "sectionKey", "sectionNo", "sectionNoOriginal", "sourceUrl", "translation", "versionLabel" ],
        "type" : "object"
      },
      "SectionRef" : {
        "properties" : {
          "headingBn" : {
            "type" : "string"
          },
          "headingEn" : {
            "type" : "string"
          },
          "sectionKey" : {
            "type" : "string"
          },
          "sectionNo" : {
            "type" : "string"
          },
          "sectionNoOriginal" : {
            "type" : "string"
          }
        },
        "required" : [ "headingBn", "headingEn", "sectionKey", "sectionNo", "sectionNoOriginal" ],
        "type" : "object"
      },
      "TokenResponse" : {
        "default" : null,
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "expiresIn" : {
            "format" : "int64",
            "type" : "integer"
          },
          "guest" : {
            "type" : "boolean"
          },
          "tokenType" : {
            "type" : "string"
          },
          "user" : {
            "allOf" : [ {
              "$ref" : "#/components/schemas/Me"
            } ],
            "nullable" : true
          }
        },
        "required" : [ "accessToken", "expiresIn", "guest", "tokenType", "user" ],
        "type" : "object"
      },
      "Translation" : {
        "properties" : {
          "lang" : {
            "type" : "string"
          },
          "official" : {
            "type" : "boolean"
          },
          "text" : {
            "type" : "string"
          }
        },
        "required" : [ "lang", "official", "text" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "description" : "Verified employment-contract intelligence for Bangladesh. Not legal advice (এটা আইনি পরামর্শ নয়).",
    "license" : {
      "name" : "Proprietary"
    },
    "title" : "ShromikAI API",
    "version" : "v1"
  },
  "openapi" : "3.0.1",
  "paths" : {
    "/api/v1/admin/laws/ingest" : {
      "post" : {
        "operationId" : "ingest",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/IngestRequest"
              }
            }
          }
        },
        "responses" : {
          "202" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/IngestAccepted"
                }
              }
            },
            "description" : "Accepted"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Problem document"
          }
        },
        "tags" : [ "admin-law-controller" ]
      }
    },
    "/api/v1/auth/guest" : {
      "post" : {
        "operationId" : "guest",
        "requestBody" : {
          "content" : {
