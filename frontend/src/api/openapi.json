    "/api/v1/laws" : {
      "get" : {
        "operationId" : "acts",
        "parameters" : [ {
          "in" : "query",
          "name" : "jurisdiction",
          "required" : false,
          "schema" : {
            "default" : [ "BD" ],
            "items" : {
              "pattern" : "^(BD|ILO)$",
              "type" : "string"
            },
            "type" : "array"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/ActSummary"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Problem document"
          }
        },
        "tags" : [ "law-controller" ]
      }
    },
    "/api/v1/laws/search" : {
      "get" : {
        "operationId" : "search",
        "parameters" : [ {
          "in" : "query",
          "name" : "q",
          "required" : true,
          "schema" : {
            "maxLength" : 500,
            "minLength" : 0,
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "lang",
          "required" : false,
          "schema" : {
