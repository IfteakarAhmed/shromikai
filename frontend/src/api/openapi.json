{
  "components" : {
    "schemas" : {
      "Meta" : {
        "default" : null,
        "properties" : {
          "audit" : {
            "allOf" : [ {
              "$ref" : "#/components/schemas/MetaAudit"
            } ],
            "nullable" : true
          },
          "corpus" : {
            "$ref" : "#/components/schemas/MetaCorpus"
          },
          "models" : {
            "$ref" : "#/components/schemas/MetaModels"
          },
          "name" : {
            "type" : "string"
          },
          "version" : {
            "type" : "string"
          }
        },
        "required" : [ "audit", "corpus", "models", "name", "version" ],
        "type" : "object"
      },
      "MetaAudit" : {
        "default" : null,
        "properties" : {
          "latestEval" : {
            "allOf" : [ {
              "$ref" : "#/components/schemas/MetaLatestEval"
            } ],
            "nullable" : true
          },
          "openReviewItems" : {
            "format" : "int64",
            "type" : "integer"
          },
          "privacyBlocksLast7Days" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "latestEval", "openReviewItems", "privacyBlocksLast7Days" ],
        "type" : "object"
      },
      "MetaCorpus" : {
        "default" : null,
        "properties" : {
          "acts" : {
            "format" : "int64",
            "type" : "integer"
          },
          "currentSections" : {
            "format" : "int64",
            "type" : "integer"
          },
          "embeddedSections" : {
            "format" : "int64",
            "type" : "integer"
          },
          "lastRefreshAt" : {
            "format" : "date-time",
            "nullable" : true,
            "type" : "string"
          },
          "release" : {
            "nullable" : true,
            "type" : "string"
          },
          "sections" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "acts", "currentSections", "embeddedSections", "lastRefreshAt", "release", "sections" ],
        "type" : "object"
      },
      "MetaLatestEval" : {
        "default" : null,
        "properties" : {
          "cases" : {
            "format" : "int64",
            "type" : "integer"
          },
          "citationPrecision" : {
            "format" : "double",
            "type" : "number"
          },
          "fabricatedCitationsShown" : {
            "format" : "int64",
            "type" : "integer"
          },
          "reportDate" : {
            "type" : "string"
          },
          "riskRecall" : {
            "format" : "double",
            "type" : "number"
          }
        },
        "required" : [ "cases", "citationPrecision", "fabricatedCitationsShown", "reportDate", "riskRecall" ],
        "type" : "object"
      },
      "MetaModels" : {
        "default" : null,
        "properties" : {
          "embedding" : {
            "type" : "string"
          },
          "fast" : {
            "type" : "string"
          },
          "judge" : {
            "nullable" : true,
            "type" : "string"
          },
          "localPii" : {
            "type" : "string"
          },
          "reasoning" : {
            "type" : "string"
          },
          "verifier" : {
            "nullable" : true,
            "type" : "string"
          },
          "verifierFallback" : {
            "type" : "string"
          }
        },
        "required" : [ "embedding", "fast", "judge", "localPii", "reasoning", "verifier", "verifierFallback" ],
        "type" : "object"
      },
      "Problem" : {
        "description" : "RFC 9457 problem document (api.md §5.14)",
        "properties" : {
          "code" : {
            "description" : "Stable machine code; equals the last segment of type",
            "type" : "string"
          },
          "detail" : {
            "nullable" : true,
            "type" : "string"
          },
          "errors" : {
            "items" : {
              "$ref" : "#/components/schemas/ProblemError"
            },
            "type" : "array"
          },
          "instance" : {
            "description" : "Request path template plus request ID",
            "type" : "string"
          },
          "pages" : {
            "description" : "unreadable-document only",
            "items" : {
              "format" : "int32",
              "minimum" : 1,
              "type" : "integer"
            },
            "type" : "array"
          },
          "retryAfterSeconds" : {
            "format" : "int32",
            "minimum" : 0,
            "nullable" : true,
            "type" : "integer"
          },
          "status" : {
            "format" : "int32",
            "maximum" : 599,
            "minimum" : 400,
            "type" : "integer"
          },
          "title" : {
            "description" : "Localised by Accept-Language",
            "type" : "string"
          },
          "traceId" : {
            "type" : "string"
          },
          "type" : {
            "pattern" : "^urn:shromikai:problem:[a-z0-9-]+$",
            "type" : "string"
          }
        },
        "required" : [ "code", "instance", "status", "title", "traceId", "type" ],
        "type" : "object"
      },
      "ProblemError" : {
        "properties" : {
          "message" : {
            "type" : "string"
          },
          "pointer" : {
            "type" : "string"
          }
        },
        "required" : [ "message", "pointer" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "description" : "Verified employment-contract intelligence for Bangladesh. Not legal advice (এটা আইনি পরামর্শ নয়).",
    "license" : {
      "name" : "Proprietary"
    },
    "title" : "ShromikAI API",
    "version" : "v1"
  },
  "openapi" : "3.0.1",
  "paths" : {
    "/api/v1/meta" : {
      "get" : {
        "operationId" : "meta",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Meta"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Problem document"
          }
        },
        "tags" : [ "meta-controller" ]
      }
    }
  },
  "servers" : [ {
    "url" : "/"
  } ]
}
