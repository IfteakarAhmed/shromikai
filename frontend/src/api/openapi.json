      "post" : {
        "operationId" : "logout",
        "parameters" : [ {
          "in" : "cookie",
          "name" : "shromik_refresh",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Problem document"
          }
        },
        "tags" : [ "auth-controller" ]
      }
